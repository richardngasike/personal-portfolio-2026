# Public site URL, without a trailing slash. Used for canonical URLs, the
# sitemap and password-reset links.
NEXT_PUBLIC_SITE_URL=https://www.richardngasike.co.ke

# Supabase project (Project Settings > API). Both values are safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Verification codes from Google Search Console and Bing Webmaster
# Tools (the content value of the meta tag they give you).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Server only. Never prefix with NEXT_PUBLIC_ and never commit the real value.
# Used for: storing contact form submissions, issuing signed CV links and
# scripts/create-admin.mjs.
SUPABASE_SERVICE_ROLE_KEY=

# Server only. Any long random string; salts the hashed sender address used to
# rate-limit the contact form. Generate with: openssl rand -hex 32
CONTACT_RATE_LIMIT_SALT=
